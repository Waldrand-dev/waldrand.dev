{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "waldrand-dev",
	"main": "worker/index.ts",
	"compatibility_date": "2026-09-15",
	// The Worker owns the status API and scheduled checks; ASSETS serves the
	// static export in `out/`.
	"assets": {
		"directory": "./out",
		"binding": "ASSETS",
		// `next.config.ts` sets `trailingSlash: true`, so every route is a
		// directory with an `index.html`. The default auto-trailing-slash
		// handling redirects `/docs` to `/docs/` and serves that file.
		"html_handling": "auto-trailing-slash",
		// Serve the exported `out/404.html` for anything unmatched.
		"not_found_handling": "404-page"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "waldrand-status",
			"database_id": "bace1647-53e4-4607-8f0a-d323a2180c49",
			"migrations_dir": "migrations"
		},
		{
			"binding": "waldrand_status",
			"database_name": "waldrand-status",
			"database_id": "bace1647-53e4-4607-8f0a-d323a2180c49",
			"remote": true
		}
	],
	"triggers": {
		"crons": [
			"* * * * *"
		]
	},
	"observability": {
		"enabled": true
	}
}